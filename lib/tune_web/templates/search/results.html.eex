<%= if @q do %>
<nav class="chips search-type-chips" aria-label="Search filters">
  <%= for {type, label} <- [{:all, "All"}, {:artist, "Artists"}, {:album, "Albums"}, {:track, "Songs"}, {:playlist, "Playlists"}, {:show, "Podcasts"}] do %>
    <%= live_patch label, to: Routes.explorer_path(@socket, :search, q: @q, type: type), class: "chip #{if to_string(@type) == to_string(type), do: "active"}" %>
  <% end %>
</nav>
<% end %>
<%= case {@q, @results} do %>
  <% {nil, _results} -> %>
    <div class="section-heading"><h2>Browse all</h2></div>
    <div class="browse-grid">
      <%= for {title, query} <- [{"New Releases", "new releases"}, {"Pop", "pop"}, {"Rock", "rock"}, {"Chill", "chill"}, {"Focus", "focus"}, {"Workout", "workout"}, {"Party", "party"}, {"Indie", "indie"}, {"Country", "country"}] do %>
        <%= live_patch title, to: Routes.explorer_path(@socket, :search, q: query, type: "album"), class: "browse-card" %>
      <% end %>
    </div>
  <% {_query, %{total: 0}} -> %>
    <div class="full-screen-notice">
      <%= content_tag :p, gettext("No results") %>
    </div>
  <% {_query, results} -> %>
    <%= render PaginationView, "selector.html",
        pagination_opts: PaginationView.pagination_opts(@page, @per_page, @results.total),
        url_fn: fn(current_page, per_page) ->
          Routes.explorer_path(@socket, :search, q: @q, type: @type, page: current_page, per_page: per_page)
        end %>
    <%= if @type == :all do %>
      <%= render TuneWeb.RemoteView, "search_all.html", groups: @search_groups, q: @q, socket: @socket %>
    <% else %>
      <div class="results"><%= render_many results.items, TuneWeb.SearchView, "result.html", as: :item, socket: @socket %></div>
    <% end %>
<% end %>
