<div class="profile">
  <%= img_tag user_avatar(@user), alt: @user.name %>
  <p><%= @user.name %></p>
  <details class="profile-menu">
    <summary aria-label="Account settings"><%= render "icon.html", name: :settings %></summary>
    <nav aria-label="Account">
      <a href="/auth/spotify">Reconnect Spotify</a>
      <a href="#" id="open-button">Keyboard shortcuts</a>
      <%= link gettext("Logout"), to: Routes.auth_path(@socket, :delete), method: :post %>
      <%= link gettext("Credits"), to: "https://github.com/fully-forged/tune#credits", target: "_blank", rel: "noopener" %>
      <%= link gettext("Source"), to: "https://github.com/fully-forged/tune", target: "_blank", rel: "noopener" %>
    </nav>
  </details>
</div>
