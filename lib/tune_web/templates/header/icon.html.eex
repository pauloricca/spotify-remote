<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
  <%= case @name do %>
    <% :home -> %><path d="M3 10 12 3l9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z"/>
    <% :search -> %><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>
    <% :library -> %><path d="M4 4v16M9 4v16m5-15 4-1 4 15-4 1Z"/>
    <% :music -> %><circle cx="12" cy="12" r="10"/><path d="M6 9c4-2 8-2 12 0M7 12c3-1.5 7-1.5 10 0m-9 3c3-1 5-1 8 0"/>
    <% :settings -> %><circle cx="12" cy="12" r="3"/><path d="m9 3 6 0 1 3 3 1 2 5-2 5-3 1-1 3H9l-1-3-3-1-2-5 2-5 3-1Z"/>
    <% :heart -> %><path d="M12 21 3 12C-3 4 7-2 12 6c5-8 15-2 9 6Z"/>
    <% :device -> %><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8m-4-4v4"/>
    <% :speaker -> %><rect x="6" y="2" width="12" height="20" rx="3"/><circle cx="12" cy="14" r="3"/><path d="M10 6h4"/>
    <% :volume -> %><path d="M3 9h4l5-4v14l-5-4H3Zm13-2c3 2 3 8 0 10m3-13c5 4 5 12 0 16"/>
    <% :queue -> %><path d="M4 5h16M4 10h16M4 15h9m4 0 4 3-4 3Z"/>
    <% :menu -> %><path d="M4 6h16M4 12h16M4 18h16"/>
    <% :plus -> %><path d="M12 4v16M4 12h16"/>
    <% :close -> %><path d="m5 5 14 14M5 19 19 5"/>
    <% :shuffle -> %><path d="M3 6h3c5 0 7 12 12 12h3m-4-4 4 4-4 4M3 18h3c2 0 4-3 6-6s4-6 6-6h3m-4-4 4 4-4 4"/>
    <% :repeat -> %><path d="M4 11V8a3 3 0 0 1 3-3h13m-3-3 3 3-3 3M20 13v3a3 3 0 0 1-3 3H4m3 3-3-3 3-3"/>
    <% :playing -> %><path d="M4 10v4m4-8v12m4-15v18m4-15v12m4-8v4"/>
    <% :back -> %><path d="m15 5-7 7 7 7"/>
  <% end %>
</svg>
