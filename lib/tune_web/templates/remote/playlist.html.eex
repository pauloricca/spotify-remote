<%= case @playlist do %>
  <% :not_fetched -> %><div class="empty-state"><h1>Playlist unavailable</h1><p>Spotify couldn’t load this playlist.</p></div>
  <% playlist -> %>
    <article class="item">
      <section class="details"><div class="artwork"><%= img_tag artwork(playlist), alt: playlist.name %></div><div class="meta"><p class="eyebrow">Playlist</p><h1><%= playlist.name %></h1><p><%= playlist.description %></p><div class="reference-links"><button class="play-round" phx-click="play" phx-value-uri="<%= playlist.uri %>" aria-label="Play playlist"><%= render PlayerView, "icon_play.html", [] %></button></div></div></section>
      <%= if is_list(playlist.tracks) do %>
        <div class="tracklist"><%= for track <- playlist.tracks do %>
          <button class="song-row" phx-click="play" phx-value-uri="<%= track.uri %>" phx-value-context-uri="<%= playlist.uri %>" aria-label="Play <%= track.name %>"><%= img_tag artwork(track), alt: "", loading: "lazy" %><span class="song-meta"><span class="song-name"><%= track.name %></span><small><%= byline(track) %></small></span><span class="song-duration"><%= Tune.Duration.hms(track.duration_ms) %></span></button>
        <% end %></div>
      <% else %>
        <div class="empty-state"><p>Spotify only shares track lists for playlists you own or collaborate on. You can still play this playlist.</p><%= link "Open in Spotify ↗", to: playlist.spotify_url, target: "_blank", rel: "noopener", class: "outline-button" %></div>
      <% end %>
    </article>
<% end %>
