<div class="result" data-test-id="<%= @item.id %>">
  <div class="artwork">
    <%= live_patch to: SearchView.result_link(@item, @socket), class: "cover-link" do %>
      <%= img_tag artwork(@item), alt: @item.name, loading: "lazy" %>
    <% end %>
    <button class="card-play play-round" phx-click="play" phx-value-uri="<%= @item.uri %>" aria-label="Play <%= @item.name %>">
      <%= render PlayerView, "icon_play.html", [] %>
    </button>
  </div>
  <%= live_patch @item.name, to: SearchView.result_link(@item, @socket), class: "name" %>
  <p class="muted"><%= byline(@item) %></p>
</div>
