<div class="home-dashboard">
  <section class="touch-shelf recent-shelf" id="recently-played" phx-hook="TouchShelf" aria-labelledby="recent-heading">
    <div class="shelf-heading"><h1 id="recent-heading">Recently Played</h1>
      <div class="shelf-paging"><button class="icon-button" type="button" data-shelf-prev aria-label="Previous recently played albums"><%= render TuneWeb.HeaderView, "icon.html", name: :back %></button><button class="icon-button" type="button" data-shelf-next aria-label="More recently played albums"><%= render TuneWeb.HeaderView, "icon.html", name: :back %></button></div>
    </div>
    <%= case @suggestions_recently_played_albums do %>
      <% :not_fetched -> %><p class="shelf-notice">Recently played is unavailable. <%= live_patch "Try again", to: Routes.explorer_path(@socket, :suggestions) %></p>
      <% [] -> %><p class="shelf-notice">Play something you love. Your recent albums will appear here.</p>
      <% albums -> %>
        <div class="shelf-window"><div class="shelf-items">
          <%= for album <- albums do %>
            <button class="recent-tile" data-shelf-item phx-click="play" phx-value-uri="<%= album.uri %>" aria-label="Play <%= album.name %>" title="<%= album.name %>">
              <%= img_tag TuneWeb.RemoteView.artwork(album), alt: album.name, draggable: "false" %><span class="name"><%= album.name %></span>
              <%= if @now_playing.item && TuneWeb.RemoteView.context(@now_playing.item) && TuneWeb.RemoteView.context(@now_playing.item).uri == album.uri do %><span class="playing-badge"><%= render TuneWeb.HeaderView, "icon.html", name: :playing %></span><% end %>
            </button>
          <% end %>
        </div></div>
    <% end %>
  </section>
  <section class="touch-shelf playlist-shelf" id="home-playlists" phx-hook="TouchShelf" aria-labelledby="playlists-heading">
    <div class="shelf-heading"><h2 id="playlists-heading">Your Playlists</h2>
      <div class="shelf-paging"><button class="icon-button" type="button" data-shelf-prev aria-label="Previous playlists"><%= render TuneWeb.HeaderView, "icon.html", name: :back %></button><button class="icon-button" type="button" data-shelf-next aria-label="More playlists"><%= render TuneWeb.HeaderView, "icon.html", name: :back %></button></div>
    </div>
    <%= cond do %>
      <% @home_playlists_error -> %><p class="shelf-notice"><%= TuneWeb.RemoteView.error_message(@home_playlists_error) %> <%= if @home_playlists_error == 403 do %><a href="/auth/spotify">Reconnect Spotify</a><% else %><%= live_patch "Try again", to: Routes.explorer_path(@socket, :suggestions) %><% end %></p>
      <% @home_playlists == [] -> %><p class="shelf-notice">Your saved playlists will appear here. <%= live_patch "Find a playlist", to: Routes.explorer_path(@socket, :search, type: :playlist) %></p>
      <% true -> %>
        <div class="shelf-window"><div class="shelf-items">
          <%= for playlist <- @home_playlists do %>
            <button class="playlist-tile" data-shelf-item phx-click="play" phx-value-uri="<%= playlist.uri %>" aria-label="Play <%= playlist.name %>">
              <%= img_tag TuneWeb.RemoteView.artwork(playlist), alt: "", draggable: "false" %><span><%= playlist.name %></span>
            </button>
          <% end %>
        </div></div>
    <% end %>
  </section>
</div>
